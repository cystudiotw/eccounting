---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="聯絡我們 - 雲記帳" currentPath="/contact/">
  <!-- Cloudflare Turnstile -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <div class="w-full max-w-[1280px] mx-auto px-4 md:px-16 pt-10 pb-20">
    <!-- Header -->
    <section class="text-center mb-16">
      <h1 class="font-headline-lg text-2xl md:text-4xl text-[#005f9d] mb-4">聯絡我們</h1>
      <p class="font-body-lg text-base md:text-lg text-[#404750] max-w-2xl mx-auto leading-relaxed">
        不論是產品諮詢、商務合作或是遇到任何使用上的問題，我們的團隊隨時準備好為您提供協助。
      </p>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <!-- Left Column: Info Cards -->
      <div class="md:col-span-5 space-y-6">
        <div class="bg-white rounded-xl p-6 md:p-8 shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-[#c0c7d2]/40 space-y-4">
          <div class="w-10 h-10 rounded-lg bg-[#f3f3f4] text-[#005f9d] flex items-center justify-center">
            <span class="material-symbols-outlined text-xl">mail</span>
          </div>
          <div>
            <h3 class="font-headline-md text-lg text-[#1a1c1c] font-bold">支援與合作</h3>
            <p class="font-body-md text-sm text-[#404750] mt-1">寄送電子郵件給我們，我們通常於數日內回覆。</p>
          </div>
          <div class="pt-2">
            <a href="mailto:help@eccounting.com.tw" class="font-data-mono text-[#005f9d] text-base font-semibold hover:underline inline-flex items-center gap-1">
              help@eccounting.com.tw
              <span class="material-symbols-outlined text-sm">open_in_new</span>
            </a>
          </div>
        </div>
        <div class="bg-white rounded-xl p-6 md:p-8 shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-[#c0c7d2]/40 space-y-4">
          <div class="w-10 h-10 rounded-lg bg-[#f3f3f4] text-[#005f9d] flex items-center justify-center">
            <span class="material-symbols-outlined text-xl">schedule</span>
          </div>
          <div>
            <h3 class="font-headline-md text-lg text-[#1a1c1c] font-bold">諮詢時間</h3>
            <p class="font-body-md text-sm text-[#404750] mt-1">週一至週五，國定假日除外。</p>
          </div>
          <div class="pt-2 font-data-mono text-[#1a1c1c] text-base font-semibold">09:00 AM - 18:00 PM</div>
        </div>
      </div>

      <!-- Right Column: Contact Form -->
      <div class="md:col-span-7 bg-white rounded-xl p-6 md:p-10 shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-[#c0c7d2]/40">
        <div id="contact-form-container">
          <form id="contact-form" class="space-y-6">
            <h3 class="font-headline-md text-xl text-[#1a1c1c] font-bold">填寫諮詢需求</h3>
            <div class="space-y-4">
              <div>
                <label class="block font-label-sm text-xs md:text-sm text-[#1a1c1c] mb-1">姓名 <span class="text-[#ba1a1a]">*</span></label>
                <input type="text" name="name" required placeholder="請輸入您的姓名" class="w-full px-4 py-2.5 rounded-lg border border-[#c0c7d2] focus:border-[#005f9d] focus:ring-1 focus:ring-[#005f9d] outline-none text-sm font-body-md transition-all" />
              </div>
              <div>
                <label class="block font-label-sm text-xs md:text-sm text-[#1a1c1c] mb-1">公司名稱 / 工作室名稱</label>
                <input type="text" name="company" placeholder="例：智慧雲端科技工作室" class="w-full px-4 py-2.5 rounded-lg border border-[#c0c7d2] focus:border-[#005f9d] focus:ring-1 focus:ring-[#005f9d] outline-none text-sm font-body-md transition-all" />
              </div>
              <div>
                <label class="block font-label-sm text-xs md:text-sm text-[#1a1c1c] mb-1">聯絡信箱 <span class="text-[#ba1a1a]">*</span></label>
                <input type="email" name="email" required placeholder="name@example.com" class="w-full px-4 py-2.5 rounded-lg border border-[#c0c7d2] focus:border-[#005f9d] focus:ring-1 focus:ring-[#005f9d] outline-none text-sm font-body-md transition-all" />
              </div>
              <div>
                <label class="block font-label-sm text-xs md:text-sm text-[#1a1c1c] mb-1">您的的需求 / 諮詢問題 <span class="text-[#ba1a1a]">*</span></label>
                <textarea name="needs" required rows="4" placeholder="請簡述您的財務記帳需求、團隊規模或欲諮詢的問題..." class="w-full px-4 py-2.5 rounded-lg border border-[#c0c7d2] focus:border-[#005f9d] focus:ring-1 focus:ring-[#005f9d] outline-none text-sm font-body-md transition-all resize-none"></textarea>
              </div>
            </div>

            <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY} data-action="submit"></div>

            <!-- Error message -->
            <div id="contact-error" class="hidden p-3 bg-[#ffdad6] text-[#ba1a1a] rounded-lg text-sm font-body-md"></div>

            <button type="submit" class="w-full bg-[#005f9d] hover:bg-[#2079be] text-white font-label-sm text-sm py-3 rounded-lg transition-colors flex items-center justify-center gap-2 cursor-pointer shadow-xs">
              <span class="material-symbols-outlined text-lg">send</span>
              送出表單
            </button>
          </form>
          <!-- Success Message -->
          <div id="contact-success" class="hidden py-12 text-center space-y-4 animate-fade-in">
            <div class="w-16 h-16 bg-[#e8f5e9] text-[#2e7d32] rounded-full flex items-center justify-center mx-auto">
              <span class="material-symbols-outlined text-3xl">check</span>
            </div>
            <h3 class="font-headline-md text-2xl text-[#1a1c1c]">訊息已成功送出！</h3>
            <p class="font-body-md text-[#404750] max-w-md mx-auto">感謝您的聯絡，我們會盡快回覆您的信箱。</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    (function() {
      const form = document.getElementById('contact-form') as HTMLFormElement;
      if (!form) return;

      form.addEventListener('submit', async function(e) {
        e.preventDefault();

        const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        const errorEl = document.getElementById('contact-error');

        const turnstileInput = form.querySelector('input[name="cf-turnstile-response"]') as HTMLInputElement | null;
        const turnstileToken = turnstileInput?.value;

        if (!turnstileToken) {
          if (errorEl) {
            errorEl.textContent = '請先完成機器人驗證';
            errorEl.classList.remove('hidden');
          }
          return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined text-lg">sync</span> 傳送中...';
        if (errorEl) errorEl.classList.add('hidden');

        try {
          const formData = new FormData(form);
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: formData.get('name'),
              company: formData.get('company'),
              email: formData.get('email'),
              needs: formData.get('needs'),
              turnstileToken,
            }),
          });

          const data = await res.json();

          if (data.ok) {
            form.classList.add('hidden');
            document.getElementById('contact-success')?.classList.remove('hidden');
          } else {
            if (errorEl) {
              errorEl.textContent = data.error || '送出失敗，請稍後再試';
              errorEl.classList.remove('hidden');
            }
            btn.disabled = false;
            btn.innerHTML = '<span class="material-symbols-outlined text-lg">send</span> 送出表單';
          }
        } catch {
          if (errorEl) {
            errorEl.textContent = '網路錯誤，請檢查連線後再試';
            errorEl.classList.remove('hidden');
          }
          btn.disabled = false;
          btn.innerHTML = '<span class="material-symbols-outlined text-lg">send</span> 送出表單';
        }
      });
    })();
  </script>
</BaseLayout>
