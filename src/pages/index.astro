---
import BaseLayout from '../layouts/BaseLayout.astro';

const HERO_URL = 'https://lh3.googleusercontent.com/aida-public/AB6AXuC55QMC0I-J7nVuTUqyEIc9UX7MgwgoPdCm3mpM5i0utqzn7ONYNOfDKsaM3py9cR4g_VwY7A374dbUVBqqhqma4P6sGIRqCsyPITgz-UiiDwZ5G7URHh6WuTLZDeStJAzoTiydVhfM6l-xe5U6PCQtNCfnfxDZk9KNkLbxu_EvLUnnbl3qbhb59JkvZmYxyhLB4_daJg9OFEPRzFPoVyvC9wCoSfu4I0uL22JIp7r2kli9Uo9aatzzqijPIVEhjQFvRTuiYTzWJHSm';
---
<BaseLayout title="雲記帳 - 你的雲端財務神隊友" currentPath="/">
  <!-- Hero Section -->
  <section class="w-full max-w-[1280px] mx-auto px-4 md:px-16 py-12 md:py-24 flex flex-col md:flex-row items-center gap-8 md:gap-12">
    <div class="flex-1 flex flex-col gap-6 items-start text-left">
      <h1 class="font-headline-lg text-2xl md:text-4xl lg:text-[36px] leading-tight text-[#1a1c1c] tracking-tight">
        從自由接案到新創公司，你的雲端財務神隊友。
      </h1>
      <p class="font-body-lg text-base md:text-lg text-[#404750] max-w-2xl leading-relaxed">
        專為創業者打造的智慧記帳系統。支援多元輸入與收付自動提醒，讓營業稅申報不再是苦差事，將寶貴時間留給企業成長。
      </p>
      <div class="flex flex-col sm:flex-row gap-4 mt-2 w-full sm:w-auto">
        <a href="/features/" class="border border-[#2C80C6] text-[#2C80C6] hover:bg-[#2C80C6]/10 font-label-sm text-sm md:text-base px-6 py-3 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 text-center">
          <span class="material-symbols-outlined text-xl">play_circle</span>
          功能介紹
        </a>
      </div>
    </div>
    <div class="flex-1 w-full h-[280px] md:h-[380px] relative rounded-xl overflow-hidden border border-[#c0c7d2]/50 shadow-[0_4px_12px_rgba(0,0,0,0.05)] bg-white group">
      <img src={HERO_URL} alt="雲記帳 系統介面" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
      <div class="absolute bottom-4 left-4 right-4 bg-white/90 backdrop-blur-md p-3 rounded-lg border border-[#e2e2e2] shadow-sm flex items-center justify-between text-xs md:text-sm">
        <div class="flex items-center gap-2 text-[#005f9d] font-semibold">
          <span class="material-symbols-outlined text-base">verified</span>
          雲端財務顧問即時分析中
        </div>
        <span class="text-[#404750] font-data-mono">月省 75% 理帳時間</span>
      </div>
    </div>
  </section>

  <!-- Pain Points Section -->
  <section class="w-full bg-[#f9f9f9] py-16 md:py-24 border-t border-b border-[#e2e2e2]/60">
    <div class="max-w-[1280px] mx-auto px-4 md:px-16">
      <div class="text-center mb-12">
        <h2 class="font-headline-md text-2xl md:text-3xl text-[#1a1c1c] mb-4">
          創業路上的財務挑戰，我們都懂
        </h2>
        <p class="font-body-md text-base text-[#404750] max-w-2xl mx-auto">
          專注於業務發展，把繁雜的數字交給專業的系統。
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <!-- Pain Point 1 -->
        <div class="bg-white rounded-xl p-6 md:p-8 shadow-[0_4px_12px_rgba(0,0,0,0.05)] border-t-4 border-t-[#2C80C6] border-x border-b border-[#e8e8e8] flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="w-12 h-12 rounded-lg bg-[#f3f3f4] flex items-center justify-center text-[#005f9d] mb-4">
              <span class="material-symbols-outlined text-2xl">account_balance_wallet</span>
            </div>
            <h3 class="font-headline-md text-xl text-[#1a1c1c] mb-3">個人接案稅率高</h3>
            <p class="font-body-md text-sm md:text-base text-[#404750] leading-relaxed">
              缺乏系統性的收入與支出紀錄，導致報稅時無法有效列舉扣除額，無形中繳納了過高的稅金，侵蝕辛苦賺來的利潤。
            </p>
          </div>
        </div>
        <!-- Pain Point 2 -->
        <div class="bg-white rounded-xl p-6 md:p-8 shadow-[0_4px_12px_rgba(0,0,0,0.05)] border-t-4 border-t-[#2C80C6] border-x border-b border-[#e8e8e8] flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="w-12 h-12 rounded-lg bg-[#f3f3f4] flex items-center justify-center text-[#005f9d] mb-4">
              <span class="material-symbols-outlined text-2xl">receipt_long</span>
            </div>
            <h3 class="font-headline-md text-xl text-[#1a1c1c] mb-3">工作室沒發票流失大客戶</h3>
            <p class="font-body-md text-sm md:text-base text-[#404750] leading-relaxed">
              許多企業客戶需要正規發票報帳，若無法開立合法憑證，將錯失許多大型專案與長期合作的機會，限制業務規模。
            </p>
          </div>
        </div>
        <!-- Pain Point 3 -->
        <div class="bg-white rounded-xl p-6 md:p-8 shadow-[0_4px_12px_rgba(0,0,0,0.05)] border-t-4 border-t-[#2C80C6] border-x border-b border-[#e8e8e8] flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="w-12 h-12 rounded-lg bg-[#f3f3f4] flex items-center justify-center text-[#005f9d] mb-4">
              <span class="material-symbols-outlined text-2xl">event_busy</span>
            </div>
            <h3 class="font-headline-md text-xl text-[#1a1c1c] mb-3">報稅季帳目混亂</h3>
            <p class="font-body-md text-sm md:text-base text-[#404750] leading-relaxed">
              平時沒有養成記帳習慣，一到報稅季就要翻找滿桌的紙本收據與散落的數位明細，耗時耗力且容易出錯。
            </p>
          </div>
        </div>
      </div>
      <div class="mt-6 pt-4 border-t border-[#f3f3f4] flex justify-end items-center text-xs font-medium text-[#005f9d]">
        <a href="/startup/">
          <span>解決方案</span>
          <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Showcase Banner -->
  <section class="w-full max-w-[1280px] mx-auto px-4 md:px-16 py-16">
    <div class="bg-gradient-to-r from-[#005f9d] to-[#2079be] rounded-2xl p-8 md:p-12 text-white shadow-lg flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="space-y-3 text-center md:text-left">
        <div class="mb-2">
          <span class="bg-white/20 text-white font-label-sm text-xs px-3 py-1 rounded-full uppercase tracking-wider">
            全方位財務智慧體驗
          </span>
        </div>
        <h3 class="text-2xl md:text-3xl font-headline-md font-bold">
          準備好開啟更輕鬆的記帳流程了嗎？
        </h3>
        <p class="text-white/90 font-body-md text-sm md:text-base max-w-xl">
          立即體驗雲記帳，無須綁定信用卡註冊後即可體驗功能。
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
        <a href="https://s1.eccounting.com.tw/" target="_blank" class="bg-white text-[#005f9d] font-label-sm text-sm px-6 py-3 rounded-lg hover:bg-[#f3f3f4] transition-colors shadow-sm font-semibold text-center">
          前往免費使用
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
