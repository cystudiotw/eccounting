---
import BaseLayout from '../layouts/BaseLayout.astro';

const FAQ_ITEMS = [
  { id: 'faq-1', question: '資料安全嗎？', answer: '本系統目前尚未正式申請 ISO 27001 認證，但我們的整體架構完全參照該資訊安全標準打造。使用者可使用兩步驟驗證，在傳輸層使用TLS 1.3現代加密協定，資料庫與程式參數則嚴格採用核心加密機制保護。搭配雲端即時備份，確保您的所有財務數據安全無虞且隨時可用，您的信任是我們首要的考量。' },
  { id: 'faq-2', question: '還沒創立公司可以用嗎？', answer: '在正式設立公司前，您可以將本系統作為單純的個人收支與接案記帳工具，並完整使用應收、應付款項功能來追蹤金流與設定催繳通知。系統還能自動產出各項收支統計報表，讓您的資金流向一目了然。' },
  { id: 'faq-3', question: '可以從財政部電子發票平台匯入發票資料嗎？', answer: '系統完全支援直接匯入由「財政部電子發票整合服務平台」所下載的進項與銷項發票檔案（支援 Excel 或 CSV 格式）。您只需將國稅局後台下載的報表一鍵上傳，系統便會自動解析，將所有發票明細精準地匯入對應的帳本中。這能大幅省去人工比對與逐筆建檔的時間，確保您的帳務資料與國稅局紀錄 100% 同步。'},
  { id: 'faq-4', question: '支援哪些發票辨識格式？', answer: '系統全面支援電子發票 QR Code 掃描解析，同時具備 AI 影像辨識功能，可自動讀取傳統二聯式、三聯式及手開發票。提醒您，AI 辨識結果可能會受照片清晰度、發票折損及環境光源等客觀因素影響，為確保帳務準確，上傳後請務必自行核對辨識內容是否與實體發票完全相符。' },
  { id: 'faq-5', question: '高鐵、客運是否能扣抵營業稅', answer: '少數特定類型的憑證，因為其開立性質特殊（例如公共運輸票根、公用事業開立憑證等），即使憑證上沒有印出公司的統一編號，只要能證明是公司營運所需，依然可以申報扣抵營業稅。' },
  { id: 'faq-6', question: '報稅季如何匯出媒體申報檔？', answer: '本系統產出的媒體申報檔格式完全符合國稅局規範，只要有正確的進銷項發票資料，即可取得格式正確的 .txt 或 .bi 檔案。您可以直接將檔案匯入營業稅申報軟體中，或直接提供給合作的會計師與記帳士，讓報稅季不再手忙腳亂。' },
  { id: 'faq-7', question: '營業稅申報檔資料正確嗎？', answer: '只要輸入正確的進銷項憑證，系統即可依據國稅局規範精準產出申報資料。針對發票是否符合抵扣資格，系統會先透過 AI 智慧輔助建議會計科目與申報判斷；唯實際扣抵與申報效益仍受個別業務情境影響，最終請務必由您確認，或諮詢合格會計師、記帳士之專業評估。' },
  { id: 'faq-8', question: '可以讓團隊成員一起記帳嗎？', answer: '本系統具備多人協作架構，您可以邀請合夥人、行政員工或您的會計師、記帳士加入，並針對不同帳號設定專屬的權限等級。如此一來，既能分工合作提升記帳效率，又能嚴密保護核心財務機密的安全性。'},
  { id: 'faq-9', question: '這可以替代會計師、記帳士嗎？', answer: '本系統作為您的數位助理，負責幫您省下日常繁瑣的理帳與建檔時間；而專業的會計師、記帳士則負責為您把關，評估各項進銷項憑證是否符合法規抵扣標準，您也可以將配合會計師、記帳士加入公司多人協作。' },
  { id: 'faq-10', question: '會計師、記帳士也能使用嗎？', answer: '本系統具備多公司管理架構，會計師或記帳士可以透過單一主帳號，輕鬆建立並集中管理旗下數十、甚至數百家客戶企業的獨立帳本。無論是日常發票資料匯入、AI 自動辨識建檔，還是一鍵產出各客戶專屬的營業稅媒體申報檔，都能在同一個系統後台無縫切換。這不僅能大幅減輕事務所每月的庶務建檔負擔，更能有效提升一次服務多間客戶的整體作業效率。'},
];

const additionalSchema = [
  {
    '@type': 'FAQPage',
    mainEntity: FAQ_ITEMS.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---
<BaseLayout title="常見問題 - 雲記帳 - 你的雲端財務神隊友" currentPath="/faq/" additionalSchema={additionalSchema}>
  <div class="w-full max-w-[1280px] mx-auto px-4 md:px-8 lg:px-16 pt-10 pb-20">
    <!-- Header -->
    <section class="text-center mb-12">
      <h1 class="font-headline-lg text-2xl md:text-4xl text-[#005f9d] mb-4">常見問題</h1>
      <p class="font-body-lg text-base md:text-lg text-[#404750] max-w-2xl mx-auto leading-relaxed">
        我們整理了用戶最常詢問的問題，協助您快速了解雲記帳的服務與優勢。
      </p>
    </section>

    <!-- Accordion List using native details/summary -->
    <section class="max-w-3xl mx-auto space-y-4">
      {FAQ_ITEMS.map((item, i) => (
        <details class="bg-white rounded-xl border border-[#c0c7d2]/40 shadow-xs overflow-hidden transition-all duration-200 group" {...(i === 0 ? { open: true } : {})}>
          <summary class="w-full p-6 text-left flex justify-between items-center gap-4 hover:bg-[#f9f9f9] transition-colors cursor-pointer list-none">
            <span class="font-headline-md text-lg text-[#1a1c1c] font-semibold">{item.question}</span>
            <span class="material-symbols-outlined text-[#005f9d] transition-transform duration-300 group-open:rotate-180">expand_more</span>
          </summary>
          <div class="px-6 pb-6 pt-2 font-body-md text-base text-[#404750] leading-relaxed border-t border-[#f3f3f4] animate-fade-in">
            {item.answer}
          </div>
        </details>
      ))}
    </section>

    <!-- CTA Box -->
    <section class="mt-16 text-center bg-[#f3f3f4] rounded-xl p-8 max-w-2xl mx-auto border border-[#e2e2e2]">
      <h3 class="font-headline-md text-xl text-[#1a1c1c] mb-2 font-bold">還有其他疑問？</h3>
      <p class="font-body-md text-sm md:text-base text-[#404750] mb-6">我們的專員隨時為您提供親切的諮詢服務與導入建議。</p>
      <a href="/contact/" class="inline-block bg-[#005f9d] hover:bg-[#2079be] text-white font-label-sm text-sm px-6 py-2.5 rounded-lg transition-colors shadow-xs">與我們聯絡</a>
    </section>
  </div>
</BaseLayout>
