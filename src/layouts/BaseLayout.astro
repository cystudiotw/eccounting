---
import '../styles/global.css';

const {
  title = '雲記帳 - 你的雲端財務神隊友',
  description = '別讓繁雜帳目拖慢成長。雲記帳多種輸入記帳方式，應收付提醒通知，專為創業者打造的智慧記帳系統，申報營業稅不再是苦差事。',
  currentPath = '/',
  schemaType = 'WebPage',
  additionalSchema = [],
} = Astro.props;

const LOGO_URL = 'https://lh3.googleusercontent.com/aida-public/AB6AXuDO3lSJHht8waitGiunp2X0ooVAXOUX3bXH1Z_jhqST7TPeFx8jEbAcNGN4vT3kR1k7JN2CYBjEfJK-9hgjjdWDj7zsjn2HH7ckCdCWKJiDQLWbqH_Avw5VlBD0MHBEt4KDlb_ufyq7KvxusWUxMNmrzFQylv9yKTez2A7Bw6p_LkIeTNC24_Ao8iRDu5bC26gQz_oZMZIEER1FBE5lWcqyKoAC6peEYBd3bkdujLDKuXBEtuUkJ75K1vImTQqhFPGzA5gytFpllniF';

const currentYear = new Date().getFullYear();

const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

const navItems = [
  { href: '/features/', label: '功能介紹' },
  { href: '/faq/', label: '常見問題' },
  { href: '/startup/', label: '創業優勢' },
  { href: '/contact/', label: '聯絡我們' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const TRIAL_URL = 'https://s1.eccounting.com.tw';

const SITE_URL = import.meta.env.SITE;
const homeUrl = new URL('/', SITE_URL).href;
const pageUrl = new URL(currentPath, SITE_URL).href;
const organizationId = homeUrl + '#organization';
const websiteId = homeUrl + '#website';
const webpageId = pageUrl + '#webpage';
const breadcrumbId = pageUrl + '#breadcrumb';

const pageLabel = title.replace(/\s*-\s*雲記帳.*$/, '');

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: '雲橙工作室',
      url: 'https://cystudio.tw',
      description,
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: 'help@eccounting.com.tw',
        url: new URL('/contact/', SITE_URL).href,
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: homeUrl,
      name: '雲記帳',
      description,
      inLanguage: 'zh-TW',
      publisher: { '@id': organizationId },
    },
    {
      '@type': schemaType,
      '@id': webpageId,
      url: pageUrl,
      name: title,
      description,
      inLanguage: 'zh-TW',
      isPartOf: { '@id': websiteId },
      ...(currentPath === '/' ? {} : { breadcrumb: { '@id': breadcrumbId } }),
      publisher: { '@id': organizationId },
    },
    ...(currentPath === '/'
      ? []
      : [
          {
            '@type': 'BreadcrumbList',
            '@id': breadcrumbId,
            itemListElement: [
              { '@type': 'ListItem', position: 1, name: '首頁', item: homeUrl },
              { '@type': 'ListItem', position: 2, name: pageLabel, item: pageUrl },
            ],
          },
        ]),
    ...additionalSchema,
  ],
};
---
<!doctype html>
<html lang="zh-TW" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {import.meta.env.SITE && <link rel="canonical" href={new URL(currentPath, import.meta.env.SITE).href} />}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <meta name="theme-color" content="#f9f9f9" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Manrope:wght@600;700;800&family=Noto+Sans+TC:wght@400;500;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    {GA_MEASUREMENT_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script define:vars={{ gaId: GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body class="bg-paper text-ink font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[60] focus:rounded-md focus:bg-ledger-blue focus:px-4 focus:py-2 focus:font-label-sm focus:text-sm focus:text-white"
    >
      跳至主要內容
    </a>
    <div class="min-h-screen flex flex-col">
      <!-- Navbar -->
      <header class="fixed top-0 left-0 w-full z-50 bg-paper/95 backdrop-blur-md border-b border-mist/40 shadow-xs">
        <div class="max-w-ledger mx-auto px-4 md:px-16 h-16 flex items-center justify-between">
          <a href="/" class="flex items-center gap-2 py-2 -my-2 transition-opacity duration-200 hover:opacity-80">
            <img src={LOGO_URL} alt="" width="32" height="32" class="h-8 w-auto object-contain" />
            <span class="font-headline-md text-2xl font-bold text-ledger-blue tracking-tight">雲記帳</span>
          </a>
          <nav class="hidden md:flex items-center gap-4 lg:gap-8" aria-label="主要導覽">
            {navItems.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  // relative + before grows the hit area vertically to ~44px
                  // without changing the box, so the active underline stays tight.
                  'relative font-label-sm text-sm px-2 py-1 transition-colors duration-200 before:absolute before:inset-x-0 before:-top-2 before:-bottom-2 before:content-[""]',
                  isActive(item.href)
                    ? 'text-ledger-blue font-bold border-b-2 border-ledger-blue pb-1'
                    : 'text-graphite hover:text-ledger-blue hover:bg-vellum rounded',
                ]}
              >
                {item.label}
              </a>
            ))}
          </nav>

          <div class="hidden md:flex items-center gap-4">
            <a
              href={TRIAL_URL}
              target="_blank"
              rel="noopener"
              class="bg-ledger-blue text-white font-label-sm text-sm px-6 py-3 rounded-md hover:bg-ledger-blue-hover transition-colors duration-200 active:scale-[0.97] shadow-xs"
            >
              立即免費試用
            </a>
          </div>

          <!-- Mobile Menu Button -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="md:hidden text-graphite p-2.5 -mr-2.5 rounded-md hover:bg-vellum transition-colors"
            aria-label="開啟選單"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">menu</span>
          </button>
        </div>
        <!-- Mobile Menu Drawer -->
        <div
          id="mobile-menu"
          class="md:hidden hidden bg-white border-b border-mist/40 px-4 py-4 space-y-1 shadow-structure"
        >
          <nav aria-label="行動裝置導覽" class="flex flex-col">
            {navItems.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block font-label-sm text-lg px-4 py-3 rounded-md transition-colors duration-200',
                  isActive(item.href)
                    ? 'bg-ledger-blue/10 text-ledger-blue font-bold'
                    : 'text-graphite hover:bg-vellum',
                ]}
              >
                {item.label}
              </a>
            ))}
          </nav>
          <div class="pt-3 mt-3 border-t border-hairline">
            <a
              href={TRIAL_URL}
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center gap-1.5 w-full bg-ledger-blue text-white font-label-sm text-sm px-6 py-3 rounded-md hover:bg-ledger-blue-hover transition-colors duration-200 shadow-xs"
            >
              立即免費試用
              <span class="material-symbols-outlined text-lg" aria-hidden="true">open_in_new</span>
            </a>
          </div>
        </div>
      </header>

      <!-- Main Content -->
      <main id="main" tabindex="-1" class="flex-1 pt-20 focus:outline-none">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="bg-white border-t border-mist/40 w-full mt-auto">
        <div class="max-w-ledger mx-auto py-10 px-4 md:px-16 flex flex-col md:flex-row justify-between items-center gap-6">
          <div class="flex items-center gap-2">
            <img src={LOGO_URL} alt="" width="24" height="24" class="h-6 w-auto object-contain" />
            <span class="text-2xl font-headline-md font-bold text-ink">雲記帳</span>
          </div>
          <nav aria-label="頁尾導覽" class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
            {navItems.map((item) => (
              <a href={item.href} class="py-1 -my-1 font-label-sm text-sm text-graphite hover:text-ink hover:underline underline-offset-4 transition-colors duration-200">
                {item.label}
              </a>
            ))}
          </nav>
          <div class="flex flex-col md:items-end gap-1 text-sm text-graphite">
            <span>© {currentYear} 雲橙工作室 版權所有</span>
            <span class="flex gap-4">
              <a href="/privacy/" class="py-1 -my-1 hover:text-ink hover:underline underline-offset-4 transition-colors duration-200">隱私權政策</a>
              <a href="/terms/" class="py-1 -my-1 hover:text-ink hover:underline underline-offset-4 transition-colors duration-200">服務條款</a>
            </span>
          </div>
        </div>
      </footer>
    </div>

    <!-- Mobile menu toggle -->
    <script>
      (function () {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        if (!(menuBtn instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

        const icon = menuBtn.querySelector('.material-symbols-outlined');
        const label = menuBtn.getAttribute('aria-label');

        const setOpen = (open: boolean) => {
          menu.classList.toggle('hidden', !open);
          menuBtn.setAttribute('aria-expanded', String(open));
          if (label) menuBtn.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
          if (icon) icon.textContent = open ? 'close' : 'menu';
        };

        menuBtn.addEventListener('click', function () {
          setOpen(menuBtn.getAttribute('aria-expanded') !== 'true');
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            menuBtn.focus();
          }
        });

        window.addEventListener('resize', function () {
          if (window.innerWidth >= 768) setOpen(false);
        });
      })();
    </script>
  </body>
</html>
